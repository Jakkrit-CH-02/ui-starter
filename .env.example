# Copy to .env.local and fill in. Only VITE_* variables reach the browser —
# never put secrets here, everything in this file ends up in the bundle.

# Sub-path the app is served from, without slashes (empty = root)
VITE_APP_BASE_NAME=
# Base URL of the backend API
VITE_APP_API_ENDPOINT=http://localhost:3005/api/v1
# Base URL for images
VITE_APP_IMAGE_ROOT=

# Sign-in (OAuth / Microsoft Entra ID) — leave empty if unused
VITE_APP_TENANT_ID=
VITE_APP_CLIENT_ID=
VITE_APP_REDIRECT_URL=
VITE_APP_API_SCOPE=
